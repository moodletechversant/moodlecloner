<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/moodleclone/db" VERSION="20260924" COMMENT="XMLDB file for Moodle admin/tool/moodleclone"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_moodleclone_jobs" COMMENT="Moodle Clone backup jobs. Never holds credentials or full filesystem paths.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who requested the backup"/>
        <FIELD NAME="origin" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="web" SEQUENCE="false" COMMENT="web or cli"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, running, completed, failed or cancelled"/>
        <FIELD NAME="currentstep" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="Stage currently executing"/>
        <FIELD NAME="progress" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Overall progress 0-100"/>
        <FIELD NAME="steps" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: per-stage status, progress and error"/>
        <FIELD NAME="options" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: selected package contents and installer authorization (a password verifier only while the job waits; never the password)"/>
        <FIELD NAME="filename" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Package base name only; the directory is fixed by the plugin"/>
        <FIELD NAME="packagesize" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Package size in bytes"/>
        <FIELD NAME="packagehash" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="SHA-256 of the package file"/>
        <FIELD NAME="errorstep" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="Stage that failed"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Redacted failure message"/>
        <FIELD NAME="cancelrequested" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Set when an administrator asks a running job to stop"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Also the worker heartbeat while running"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
